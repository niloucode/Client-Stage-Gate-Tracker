  @@index([phase_id, is_deleted])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Phases {
  phase_id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          Int?
  actual_end_at   DateTime? @db.Timestamptz(6)
  name            String
  stage_id        String    @db.Uuid
  is_deleted      Boolean   @default(false)
  deleted_at      DateTime? @db.Timestamptz(6)
  description     String?
  plan_end_at     DateTime  @db.Timestamptz(6)
  plan_start_at   DateTime  @db.Timestamptz(6)
  actual_start_at DateTime? @db.Timestamptz(6)
  sort_key        String?
  Modules         Modules[]
  Stages          Stages    @relation(fields: [stage_id], references: [stage_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([stage_id, number], where: raw("(is_deleted = false)"))
  @@index([stage_id, is_deleted])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Projects {
  project_id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actual_end_at   DateTime?         @db.Timestamptz(6)
  is_deleted      Boolean           @default(false)
  deleted_at      DateTime?         @db.Timestamptz(6)
  name            String
  description     String?
  plan_end_at     DateTime          @db.Timestamptz(6)
  plan_start_at   DateTime          @db.Timestamptz(6)
  status          ProjectStatus     @default(PENDING)
  actual_start_at DateTime?         @db.Timestamptz(6)
  Contracts       Contracts?
  RoleAssignments RoleAssignments[]
  Stages          Stages[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model RoleAssignments {
  role_id    String   @db.Uuid
  user_id    String   @db.Uuid
  project_id String   @db.Uuid
  Projects   Projects @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)
  Roles      Roles    @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
  Profile    Profiles @relation(fields: [user_id], references: [profile_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([role_id, user_id, project_id])
  @@index([project_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Roles {
  role_id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @unique
  RoleAssignments RoleAssignments[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Stages {
  stage_id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          Int?
  actual_end_at   DateTime? @db.Timestamptz(6)
  name            String
  project_id      String    @db.Uuid
  is_deleted      Boolean   @default(false)
  deleted_at      DateTime? @db.Timestamptz(6)
  description     String?
  plan_end_at     DateTime  @db.Timestamptz(6)
  plan_start_at   DateTime  @db.Timestamptz(6)
  actual_start_at DateTime? @db.Timestamptz(6)
  Gates           Gates[]
  Phases          Phases[]
  Projects        Projects  @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([project_id, number], where: raw("(is_deleted = false)"))
  @@index([project_id, is_deleted])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Tags {
  tag_id      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @unique(map: "Tags_tag_key")
  description String?
  color       String?
  is_deleted  Boolean      @default(false)
  deleted_at  DateTime?    @db.Timestamptz(6)
  TicketTags  TicketTags[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model TicketAssigned {
  ticket_id     String   @db.Uuid
  profile_id    String   @db.Uuid
  assigned_date DateTime @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  Tickets       Tickets  @relation(fields: [ticket_id], references: [ticket_id], onDelete: NoAction, onUpdate: NoAction)
  Profile       Profiles @relation(fields: [profile_id], references: [profile_id], onDelete: NoAction, onUpdate: NoAction, map: "TicketAssigned_user_id_fkey")

  @@id([ticket_id, profile_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model TicketTags {
  ticket_id String  @db.Uuid
  tag_id    String  @db.Uuid
  Tags      Tags    @relation(fields: [tag_id], references: [tag_id], onDelete: NoAction, onUpdate: NoAction)
  Tickets   Tickets @relation(fields: [ticket_id], references: [ticket_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([ticket_id, tag_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Tickets {
  ticket_id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_date DateTime         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  actual_end_at   DateTime?        @db.Timestamptz(6)
  plan_end_at     DateTime         @db.Timestamptz(6)
  name            String
  description     String?
  status          status           @default(PENDING)
  workflow_id     String           @db.Uuid
  is_deleted      Boolean          @default(false)
  deleted_at      DateTime?        @db.Timestamptz(6)
  watcher_id      String?          @db.Uuid
  api_route       String?
  api_method      ApiMethod?
  plan_start_at   DateTime?        @db.Timestamptz(6)
  actual_start_at DateTime?        @db.Timestamptz(6)
  parent_id       String?          @db.Uuid
  issue_id        String?          @db.Uuid
  HistoryEvent    HistoryEvent[]
  TicketAssigned  TicketAssigned[]
  TicketTags      TicketTags[]
  Issues          Issues?          @relation(fields: [issue_id], references: [issue_id], onDelete: NoAction, onUpdate: NoAction)
  parent          Tickets?         @relation("SubTickets", fields: [parent_id], references: [ticket_id], onDelete: NoAction, onUpdate: NoAction)
  subTickets      Tickets[]        @relation("SubTickets")
  Profile         Profiles?        @relation(fields: [watcher_id], references: [profile_id], onDelete: NoAction, onUpdate: NoAction)
  Workflows       Workflows        @relation(fields: [workflow_id], references: [workflow_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workflow_id, status])
  @@index([status, is_deleted])
  @@index([workflow_id, is_deleted])
  @@index([issue_id])
  @@index([parent_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Workflows {
  workflow_id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  actual_end_at   DateTime? @db.Timestamptz(6)
  is_approved     Boolean   @default(false)
  module_id       String    @db.Uuid
  is_deleted      Boolean   @default(false)
  deleted_at      DateTime? @db.Timestamptz(6)
  number          Int?
  plan_end_at     DateTime  @db.Timestamptz(6)
  plan_start_at   DateTime  @db.Timestamptz(6)
  actual_start_at DateTime? @db.Timestamptz(6)
  sort_key        String?
  Tickets         Tickets[]
  Modules         Modules   @relation(fields: [module_id], references: [module_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([number, module_id], map: "unique_workflow_number_module", where: raw("(is_deleted = false)"))
  @@index([module_id, is_deleted])
  @@schema("public")
}

/// Issues are hard-deleted (no is_deleted/deleted_at) by explicit design —
/// issue reports are short-lived operational records, not domain entities.
model Issues {
  issue_id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  type               String
  description        String?
  urgency            IssueUrgency
  system_environment String?
  time_of_error      DateTime?    @db.Timestamptz(6)
  IssueSteps         IssueSteps[]
  Tickets            Tickets[]

  @@schema("public")
}

/// Reproduce-the-issue steps; composite key = (issue, step number).
model IssueSteps {
  issue_id String  @db.Uuid
  number   Int
  step     String
  image    String?
  Issues   Issues  @relation(fields: [issue_id], references: [issue_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([issue_id, number])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Profiles {
  profile_id                                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image_id                                         String?           @db.Uuid
  client_id                                        String?           @db.Uuid
  department_id                                    String?           @db.Uuid
  email                                            String            @unique(map: "Users_email_key")
  phone                                            String?           @unique(map: "Users_phone_key")
  first_name                                       String
  last_name                                        String
  job_title                                        String?
  is_deleted                                       Boolean           @default(false)
  deleted_at                                       DateTime?         @db.Timestamptz(6)
  Comments                                         Comments[]
  GateSignatures                                   GateSignatures[]
  HistoryEvent_HistoryEvent_performed_byToProfiles HistoryEvent[]    @relation("HistoryEvent_performed_byToProfiles")
  HistoryEvent                                     HistoryEvent[]
  Clients                                          Clients?          @relation(fields: [client_id], references: [client_id], onDelete: NoAction, onUpdate: NoAction, map: "Users_client_id_fkey")
  Department                                       Department?       @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction, map: "Users_department_id_fkey")
  Images                                           Images?           @relation(fields: [image_id], references: [image_id], onDelete: NoAction, onUpdate: NoAction, map: "Users_image_id_fkey")
  authUser                                         users             @relation(fields: [profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Users_user_id_fkey")
  RoleAssignments                                  RoleAssignments[]
  TicketAssigned                                   TicketAssigned[]
  Tickets                                          Tickets[]

  @@index([email(ops: raw("gin_trgm_ops"))], map: "Profiles_email_trgm_idx", type: Gin)
  @@index([first_name(ops: raw("gin_trgm_ops"))], map: "Profiles_first_name_trgm_idx", type: Gin)
  @@index([last_name(ops: raw("gin_trgm_ops"))], map: "Profiles_last_name_trgm_idx", type: Gin)
  @@schema("public")
}

enum action {
  CREATED
  FINISHED
  UPDATED_STATUS
  RENAMED
  COMMENT_ADDED
  ASSIGNED
  UNASSIGNED
  DELETE
  WATCHER_CHANGED

  @@schema("public")
}

enum status {
  PENDING
  IN_PROGRESS
  FINISHED

  @@schema("public")
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum CommentParentType {
  TICKET_COMMENT
  GATE_COMMENT

  @@schema("public")
}

enum ImageParentType {
  TICKET
  TICKET_COMMENT
  GATE_COMMENT
  PROFILE
  ISSUE_STEP

  @@schema("public")
}

enum ApiMethod {
  GET
  POST
  PUT
  DELETE

  @@schema("public")
}

enum ProjectStatus {
  ACTIVE
  PENDING
  COMPLETED

  @@schema("public")
}

enum GateStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

enum IssueUrgency {
  LOW
  MEDIUM
  HIGH

  @@schema("public")
}
