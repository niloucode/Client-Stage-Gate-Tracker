/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model GateSignatures {
  gate_id    String   @id @db.Uuid
  profile_id String   @db.Uuid
  signature  String
  signed_at  DateTime @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  Gates      Gates    @relation(fields: [gate_id], references: [gate_id], onDelete: NoAction, onUpdate: NoAction)
  Profile    Profiles @relation(fields: [profile_id], references: [profile_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model HistoryEvent {
  history_event_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action            action
  performed_at      DateTime  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  ticket_id         String    @db.Uuid
  target_profile_id String?   @db.Uuid
  performed_by      String    @db.Uuid
  details           String?
  Performer         Profiles  @relation("HistoryEvent_performed_byToProfiles", fields: [performed_by], references: [profile_id], onDelete: NoAction, onUpdate: NoAction)
  TargetProfile     Profiles? @relation(fields: [target_profile_id], references: [profile_id], onDelete: NoAction, onUpdate: NoAction)
  Tickets           Tickets   @relation(fields: [ticket_id], references: [ticket_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ticket_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Images {
  image_id    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image_src   String          @unique
  parent_type ImageParentType
  parent_id   String          @db.Uuid
  is_deleted  Boolean         @default(false)
  deleted_at  DateTime?       @db.Timestamptz(6)
  Profiles    Profiles[]

  @@index([parent_type, parent_id, is_deleted])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Modules {
  module_id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  actual_end_at   DateTime?   @db.Timestamptz(6)
  phase_id        String      @db.Uuid
  is_deleted      Boolean     @default(false)
  deleted_at      DateTime?   @db.Timestamptz(6)
  plan_end_at     DateTime    @db.Timestamptz(6)
  plan_start_at   DateTime    @db.Timestamptz(6)
  actual_start_at DateTime?   @db.Timestamptz(6)
  Phases          Phases      @relation(fields: [phase_id], references: [phase_id], onDelete: NoAction, onUpdate: NoAction)
