# Stage-Gate Tracker — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# The canonical key list lives in `src/env.ts` (validated by @t3-oss/env-nextjs).

# ── Supabase (app) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Database (Prisma) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct (pooler-bypassing) connection — used by migrations and scripts.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Local Postgres used as Prisma's shadow database for `prisma migrate dev`
# (Supabase's managed Postgres cannot create databases). See CONTRIBUTING §2.
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# ── Server secrets ───────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# HMAC pepper for client invite codes — REQUIRED in production (dev falls
# back to a known pepper with a warning).
CLIENT_INVITE_PEPPER=

# ── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOWED_CONNECT_ORIGINS=http://localhost:3000
PRISMA_LOG_LEVEL=
# Set to "1" to skip t3-env validation (CI builds without secrets).
SKIP_ENV_VALIDATION=
